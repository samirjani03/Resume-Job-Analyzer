# ==========================================================
# TalentMatch AI — Environment variables (copy to .env / Render)
# ==========================================================

# --- Backend (Render web service / local uvicorn) ---
# Encryption key for API keys at rest. On Render set this once;
# locally it auto-generates into backend/.encryption_key.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Hosted mode: true -> 401 until the user saves an AI provider key.
# Local dev: false -> legacy behavior (config-driven local Ollama).
REQUIRE_PROVIDER=false

# Max LLM calls per device per day (hosted mode only).
DAILY_QUOTA=20

# Comma-separated CORS origins. "*" for local dev.
ALLOWED_ORIGINS=*

# Database. Local default is SQLite; set Supabase/Neon Postgres URL for hosted.
DATABASE_URL=sqlite:///./talentmatch.db

# --- Interview report emails (optional, Resend HTTP API) ---
# If RESEND_API_KEY is empty, "Send Reports" returns downloadable HTML drafts instead.
RESEND_API_KEY=
EMAIL_FROM="TalentMatch AI <onboarding@resend.dev>"
EMAIL_FROM_NAME="TalentMatch AI"
# Fallback recipients when the recruiter leaves the fields blank:
RECIPIENT_CANDIDATE=
RECIPIENT_RECRUITER=

# --- Frontend (Vercel) ---
# Points the React app at your backend API.
VITE_API_BASE=https://talentmatch-backend.onrender.com/api/v1

# ===========================================================
# Docker (docker compose up -d --build) — uses this file too
# ===========================================================
# docker compose reads THIS file for: REQUIRE_PROVIDER, DAILY_QUOTA,
# ENCRYPTION_KEY, RESEND_API_KEY, RECIPIENT_CANDIDATE, RECIPIENT_RECRUITER.
# - REQUIRE_PROVIDER: the image defaults to true (each user saves a provider
#   key in Settings). If you keep `false` here, the container will instead try
#   the Ollama URL baked into the image (no Ollama runs inside Docker).
# - ENCRYPTION_KEY: leave EMPTY for Docker — the key is auto-generated at
#   /data/.encryption_key inside the Docker volume (see README, Docker section).
# - DATABASE_URL / VITE_API_BASE are ignored by Docker: the container always
#   uses /data/talentmatch.db and serves the frontend from the same origin.